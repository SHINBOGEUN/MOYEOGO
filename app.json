{
  "expo": {
    "name": "모여Go",
    "slug": "moyeogo",
    "scheme": "moyeogo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/moyeogo-route-app-icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "여행 기록에 사진을 추가하기 위해 사진 보관함에 접근합니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "react-native-maps",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "defaultChannel": "friend-updates"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F6F2E8",
        "foregroundImage": "./assets/moyeogo-route-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.shinbogeun.moyeogo"
    },
    "web": {
      "favicon": "./assets/moyeogo-route-app-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "12e5c5e2-6f4b-4d40-bad4-490e15d8f143"
      }
    },
    "owner": "shinbogeun"
  }
}
